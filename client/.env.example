# ==============================================================================
# SHREE TIFFIN SERVICE — FRONTEND ENVIRONMENT CONFIGURATION TEMPLATE
# Tagline: "Ghar Jaisa Khana, Har Din."
# IMPORTANT: Frontend ONLY accepts public VITE_* variables.
# NEVER include private secrets, JWT keys, or Razorpay secret keys here!
# ==============================================================================

# Backend API Base URL
# Development: /api (proxied by Vite to http://localhost:5000)
# Production (separate frontend/backend hosting): https://your-backend-service.onrender.com/api
# Production (unified single-service hosting): /api
# (Both VITE_API_BASE_URL and VITE_API_URL are supported)
VITE_API_BASE_URL=/api
VITE_API_URL=https://your-backend-service.onrender.com/api

# Optional Public Razorpay Key ID (Client-side fallback if not fetched from backend API)
# MUST BE PUBLIC KEY ONLY (starts with rzp_test_ or rzp_live_). NEVER PUT SECRET KEY HERE!
VITE_RAZORPAY_KEY_ID=rzp_test_or_live_public_key_id
