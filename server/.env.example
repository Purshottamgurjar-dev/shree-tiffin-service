# ==============================================================================
# SHREE TIFFIN SERVICE — SERVER ENVIRONMENT CONFIGURATION TEMPLATE
# Tagline: "Ghar Jaisa Khana, Har Din."
# IMPORTANT: Copy this file to .env and fill in real secrets. NEVER commit .env!
# ==============================================================================

# Server Environment & Port
PORT=5000
NODE_ENV=production

# Frontend Client Origin (Used for CORS validation)
# Development: http://localhost:5173
# Production:  https://your-frontend-app.onrender.com (or custom domain)
CLIENT_URL=https://your-frontend-app.onrender.com

# MongoDB Atlas Production Connection URI
# Target Database MUST be "shree_tiffin_service" (Tests automatically target shree_tiffin_service_test)
MONGO_URI=mongodb+srv://<db_username>:<db_password>@<cluster>.mongodb.net/shree_tiffin_service?retryWrites=true&w=majority

# JWT Authentication Secrets
# Generate a strong 32+ character random secret (e.g., openssl rand -base64 32)
JWT_SECRET=your_production_jwt_secret_min_32_chars_long
JWT_EXPIRE=30d

# Razorpay Payment Gateway (Test or Live Mode)
# Retrieve from https://dashboard.razorpay.com/app/keys
RAZORPAY_KEY_ID=rzp_test_or_live_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_razorpay_webhook_secret

# Initial Kitchen Owner Seed Credentials (Applied only if owner account does not exist)
OWNER_EMAIL=owner@shreetiffin.com
OWNER_PASSWORD=YourStrongPassword@123
OWNER_NAME=Shree Kitchen Owner
OWNER_PHONE=9876543210
